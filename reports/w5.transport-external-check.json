{
  "adapter_source": "use fontpixel::{Input, ReadOptions, ResourceLimits, ResourcePath, WriteOptions};\nuse fontpixel::formats::{raw,ssfn};\nuse fontpixel::resources::TransportLimits;\nfn main()->Result<(),Box<dyn std::error::Error>>{\n let a:Vec<_>=std::env::args().collect();let data=std::fs::read(&a[1])?;let id=[\"raw\",\"bdf\",\"ssfn\"][(data[0]%3) as usize];\n let limits=ResourceLimits{max_input_bytes:262144,max_total_bytes:2097152,max_decompressed_bytes:262144,max_glyphs:256,max_pixels_per_glyph:4096,max_table_bytes:262144,max_resources:8,..Default::default()};\n let mut layout=raw::RawLayout::new(1,1);layout.first_codepoint=32;layout.count=Some(1);\n let mut reader=fontpixel::registry();reader.set_raw_read_options(raw::RawReadOptions{layout:Some(layout.clone())});let ro=ReadOptions{format:Some(id.into()),limits:limits.clone()};let source=reader.read(&Input::new(&data[16..]),&ro)?;\n assert_eq!(source.fonts.fonts.len(),1);assert_eq!(source.fonts.fonts[0].len(),1);let glyph=source.fonts.fonts[0].glyphs().next().unwrap().1;\n assert_eq!(glyph.bitmap.as_bytes(),if id==\"raw\" { &[128][..] } else { &[128,64][..] });assert_eq!((glyph.bitmap.width(),glyph.bitmap.height()),if id==\"raw\" {(1,1)} else {(2,2)});assert_eq!(glyph.codepoints[0].value(),if id==\"raw\" {32}else{65});\n let mut writer=fontpixel::registry();writer.set_raw_write_options(raw::RawWriteOptions{layout:Some(layout),limits:limits.clone(),max_output_bytes:262144,..Default::default()});writer.set_ssfn_write_options(ssfn::SsfnWriteOptions{encoding:if data[2]&128==0 {ssfn::SsfnEncoding::Binary}else{ssfn::SsfnEncoding::Ascii},limits:limits.clone(),max_output_bytes:262144,..Default::default()});\n let mut po=WriteOptions::new(ResourcePath::new(\"native\")?);po.transport_limits=Some(TransportLimits{resources:limits,max_output_bytes:262144});let plain=writer.write(&source.fonts,id,&po)?.output.into_single()?;po.primary_name=ResourcePath::new(\"native.gz\")?;let gzip=writer.write(&source.fonts,id,&po)?.output.into_single()?;\n assert_eq!(reader.read(&Input::new(&plain),&ro)?.fonts,reader.read(&Input::new(&gzip),&ro)?.fonts);std::fs::write(format!(\"{}.plain\",a[2]),plain)?;std::fs::write(format!(\"{}.gz\",a[2]),gzip)?;println!(\"{id}: original pixels/code + complete plain/gzip model passed\");Ok(())\n}\n",
