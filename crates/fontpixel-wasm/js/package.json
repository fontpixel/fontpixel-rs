{
  "name": "fontpixel",
  "version": "0.1.0",
  "description": "Bitmap font toolkit for JavaScript (WebAssembly): read, edit, render and write 99 font formats, plus a bdfparser-js compatible API",
  "private": true,
  "license": "MIT",
  "author": "Tom Chen",
  "homepage": "https://github.com/fontpixel/fontpixel-rs/tree/main/crates/fontpixel-wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fontpixel/fontpixel-rs.git",
    "directory": "crates/fontpixel-wasm"
  },
  "bugs": "https://github.com/fontpixel/fontpixel-rs/issues",
  "keywords": ["font", "bitmap-font", "pixel-font", "bdf", "pcf", "opentype", "woff2", "bdfparser", "webassembly", "wasm"],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./node-files": {
      "types": "./ops-node-files.d.ts",
      "node": "./ops-node-files.js"
    },
    "./ops-worker.js": "./ops-worker.js",
    "./compat/bdfparser": {
      "types": "./compat_bdfparser.d.ts",
      "default": "./compat_bdfparser.js"
    },
    "./compat/bdfparser/cjk": {
      "types": "./compat_bdfparser_cjk.d.ts",
      "default": "./compat_bdfparser_cjk.js"
    },
    "./compat/bdfparser/cli": {
      "types": "./compat_bdfparser_cli.d.ts",
      "default": "./compat_bdfparser_cli.js"
    },
    "./fontpixel_wasm_bg.wasm": "./fontpixel_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "*.wasm",
    "build-info.json",
    "profiles/",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./index.js",
    "./guard.js",
    "./ops-worker.js",
    "./compat_bdfparser.js",
    "./compat_bdfparser_cjk.js"
  ],
  "engines": {
    "node": ">=18"
  }
}
